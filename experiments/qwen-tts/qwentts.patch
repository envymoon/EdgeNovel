diff --git a/src/pipeline-tts.cpp b/src/pipeline-tts.cpp
index 7e64d76..c8033c3 100644
--- a/src/pipeline-tts.cpp
+++ b/src/pipeline-tts.cpp
@@ -253,8 +253,27 @@ bool pipeline_tts_load(PipelineTTS * pt,
     // to 4096 positions (the longest ICL prompt observed is ~250 +
     // max_new_tokens ~ 1500, so 4096 has 60% headroom). Predictor holds
     // one frame of 16 sub-steps per slot.
+    // QWEN_TTS_CTX shrinks it for callers that only ever speak a sentence
+    // or two: the cache is F32 and 4096 positions of it is 896 MB on the
+    // 0.6B talker. A request that reaches the end stops there (see the
+    // frame loop) instead of failing.
+    int max_ctx = 4096;
+    if (const char * env = getenv("QWEN_TTS_CTX")) {
+        const int v = atoi(env);
+        if (v >= 256 && v <= 4096) {
+            max_ctx = v;
+        }
+    }
+    // QWEN_TTS_KV=f16 halves it again: flash attention reads F16 K/V
+    // natively, and the CPU chain's mul_mat takes F16 on the K side.
+    ggml_type kv_type = GGML_TYPE_F32;
+    if (const char * env = getenv("QWEN_TTS_KV")) {
+        if (std::strcmp(env, "f16") == 0) {
+            kv_type = GGML_TYPE_F16;
+        }
+    }
     if (!kv_cache_init(&pt->talker_kv, pt->talker.num_hidden_layers, pt->talker.num_key_value_heads,
-                       pt->talker.head_dim, 4096, pt->max_batch, pt->backend)) {
+                       pt->talker.head_dim, max_ctx, pt->max_batch, pt->backend, kv_type)) {
         ggml_backend_sched_free(pt->sched);
         pt->sched = NULL;
         pipeline_codec_free(&pt->codec);
@@ -1316,7 +1335,8 @@ void tts_engine_step(TtsEngine * e, std::vector<TtsJob *> * retired) {
                     if ((s.step % 8) == 0) {
                         qt_log(QT_LOG_INFO, "[Pipeline] Generated %d frames (slot %d)", s.step, i);
                     }
-                    if (s.step >= p->max_new_tokens) {
+                    if (s.step >= p->max_new_tokens ||
+                        s.prompt.T_ctx + s.step + 2 >= pt->talker_kv.max_seq_len) {
                         s.finished = true;
                     }
                 }
diff --git a/src/talker-weights.h b/src/talker-weights.h
