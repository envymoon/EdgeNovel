     tw->text_proj_fc1_w = gf_load_tensor(&wctx, gf, "talker.text_proj.fc1.weight");
     tw->text_proj_fc1_b = gf_load_tensor(&wctx, gf, "talker.text_proj.fc1.bias");
     tw->text_proj_fc2_w = gf_load_tensor(&wctx, gf, "talker.text_proj.fc2.weight");
@@ -178,6 +191,28 @@ static bool talker_weights_load(TalkerWeights * tw, const GGUFModel & gf, ggml_b
     tw->weight_ctx = wctx.ctx;
     tw->weight_buf = wctx.buffer;
 
+    if (embd_mmap) {
+        const char *         name = "talker.text_embd.weight";
+        struct ggml_tensor * src  = ggml_get_tensor(gf.meta, name);
+        void *               data = (void *) gf_get_data(gf, name);
+        if (!src || !data) {
+            qt_log(QT_LOG_ERROR, "[Talker] FATAL: %s not found", name);
+            return false;
+        }
+        struct ggml_init_params ep = { ggml_tensor_overhead() * 2, NULL, true };
+        tw->embd_ctx               = ggml_init(ep);
+        tw->text_embedding         = ggml_new_tensor(tw->embd_ctx, src->type, ggml_n_dims(src), src->ne);
+        ggml_set_name(tw->text_embedding, name);
+        tw->embd_buf = ggml_backend_cpu_buffer_from_ptr(data, ggml_nbytes(src));
+        if (!tw->embd_buf || ggml_backend_tensor_alloc(tw->embd_buf, tw->text_embedding, data) != GGML_STATUS_SUCCESS) {
+            qt_log(QT_LOG_ERROR, "[Talker] FATAL: could not map %s", name);
+            return false;
+        }
+        ggml_backend_buffer_set_usage(tw->embd_buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        qt_log(QT_LOG_INFO, "[Talker] text embedding read in place from the file (%.1f MB)",
+               (float) ggml_nbytes(src) / (1024 * 1024));
+    }
+
     qt_log(QT_LOG_INFO,
            "[Talker] Loaded: %d layers, hidden %d, heads %d/%d, head_dim %d, "
            "FFN %d, RoPE theta %.0f, mrope sections [%d,%d,%d] interleaved=%d",
@@ -188,6 +223,14 @@ static bool talker_weights_load(TalkerWeights * tw, const GGUFModel & gf, ggml_b
 }
 
