     struct ggml_context * weight_ctx;
     ggml_backend_buffer_t weight_buf;
+
+    // The text embedding when it is read in place from the file mapping
+    // (QWEN_TTS_EMBD_MMAP): its own tensor context and a CPU buffer over
+    // the mapped bytes.
+    struct ggml_context * embd_ctx = nullptr;
+    ggml_backend_buffer_t embd_buf = nullptr;
 };
 
 static bool talker_weights_load(TalkerWeights * tw, const GGUFModel & gf, ggml_backend_t backend) {
@@ -131,7 +138,13 @@ static bool talker_weights_load(TalkerWeights * tw, const GGUFModel & gf, ggml_b
     wctx_init(&wctx, n_tensors);
 
     tw->codec_embedding = gf_load_tensor(&wctx, gf, "talker.codec_embd.weight");
-    tw->text_embedding  = gf_load_tensor(&wctx, gf, "talker.text_embd.weight");
+    // QWEN_TTS_EMBD_MMAP: the text embedding is 151936 rows and a request
+    // reads a few dozen of them, once, to build its prompt. It is a third
+    // of the 0.6B file (330 MB at Q8_0); on the GPU it would sit there
