+// A quantized kernel can't keep the [KW, KH, IC, OC] layout: its KW-long rows are
+// shorter than a quantization block. It is stored as the [KW*KH*IC, OC] matrix that
+// ggml_conv_2d reshapes it to anyway, and multiplies the unfolded input directly.
+static ggml_tensor* conv_2d_matrix(ggml_context* ctx,
+                                   ggml_tensor* x,
+                                   ggml_tensor* w,
+                                   int s0,
+                                   int s1,
+                                   int p0,
+                                   int p1,
+                                   int d0,
+                                   int d1) {
+    // The matrix only gives KW*KH; every kernel stored this way is square.
+    const int64_t IC = x->ne[2];
+    const int64_t K  = static_cast<int64_t>(std::lround(std::sqrt(static_cast<double>(w->ne[0] / IC))));
+    GGML_ASSERT(K * K * IC == w->ne[0]);
+
+    // im2col reads nothing but the kernel's shape from its first argument.
+    // F32 columns: the CPU backend multiplies quantized weights by nothing else, and
+    // GPUs without NVIDIA's coopmat2 would dequantize a copy of the kernel for F16
+    // ones (10% slower on an Iris Xe). The price is a compute buffer about 100MB
+    // larger at 512x768 than with the F16 columns ggml_conv_2d uses.
+    ggml_tensor* shape = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, K, K, IC, 1);
+    ggml_tensor* cols  = ggml_im2col(ctx, shape, x, s0, s1, p0, p1, d0, d1, true, GGML_TYPE_F32);  // [N, OH, OW, IC*KH*KW]
+    ggml_tensor* y     = ggml_mul_mat(ctx, w, ggml_reshape_2d(ctx, cols, cols->ne[0], ggml_nrows(cols)));
+    y                  = ggml_reshape_4d(ctx, y, w->ne[1], cols->ne[1], cols->ne[2], cols->ne[3]);  // [N, OH, OW, OC]
+    return ggml_cont(ctx, ggml_permute(ctx, y, 2, 0, 1, 3));                                       // [N, OC, OH, OW]
+}
