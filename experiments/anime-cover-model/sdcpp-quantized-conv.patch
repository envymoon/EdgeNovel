 struct TensorExportInfo {
     TensorStorage storage;
     ggml_type type;
+    // Written as the [KW*KH*IC, OC] matrix of a [KW, KH, IC, OC] conv kernel, the only
+    // shape it can be quantized in; Conv2d and ggml_ext_conv_2d read it back.
+    bool kernel_as_matrix = false;
 };
 
+static TensorStorage kernel_matrix_storage(const TensorStorage& storage) {
+    TensorStorage matrix = storage;
+    matrix.n_dims        = 2;
+    matrix.ne[0]         = storage.ne[0] * storage.ne[1] * storage.ne[2];
+    matrix.ne[1]         = storage.ne[3];
+    for (int i = 2; i < SD_MAX_DIMS; i++) {
+        matrix.ne[i] = 1;
+    }
+    return matrix;
+}
+
+// Square conv kernels of a UNet, the model whose convolutions all go through Conv2d.
+static bool is_unet_conv_kernel(const TensorStorage& storage, SDVersion version) {
+    return sd_version_is_unet(version) &&
+           storage.n_dims == 4 &&
+           storage.ne[0] == storage.ne[1] &&
+           (storage.type == GGML_TYPE_F16 || storage.type == GGML_TYPE_F32 || storage.type == GGML_TYPE_BF16) &&
+           !storage.is_f64 && !storage.is_i64 &&
+           starts_with(convert_tensor_name(storage.name, version), "model.diffusion_model.") &&
+           ends_with(storage.name, ".weight");
+}
