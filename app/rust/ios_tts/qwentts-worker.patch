diff -ru a/src/pipeline-tts.cpp b/src/pipeline-tts.cpp
--- a/src/pipeline-tts.cpp
+++ b/src/pipeline-tts.cpp
@@ -596,6 +596,17 @@
     delete e;
 }
 
+void tts_engine_fail_all(TtsEngine * e, std::vector<TtsJob *> * retired, const char * why) {
+    for (TtsSlot & s : e->slots) {
+        if (s.job) {
+            s.job->status = QT_STATUS_GENERATE_FAILED;
+            s.job->error  = why;
+            retired->push_back(s.job);
+        }
+    }
+    e->slots.clear();
+}
+
 int tts_engine_active(const TtsEngine * e) {
     return (int) e->slots.size();
 }
