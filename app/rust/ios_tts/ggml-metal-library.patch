 typedef decltype(kernel_cpy_t_t<float, float>) kernel_cpy_t;
 
+// A copy out of a view whose dim 1 is the contiguous one (a transpose) into a contiguous tensor of
+// the same shape, by 32x32 tiles through threadgroup memory: read along dim 1 and written along
+// dim 0, both in rows. kernel_cpy_t_t reads such a view a strided element at a time. Groups of
+// 32x8 threads, a tile a group; the same values as kernel_cpy_t_t writes.
+template<typename T0, typename T1>
+kernel void kernel_cpy_tr(
+        constant ggml_metal_kargs_cpy & args,
+        device  const char * src0,
+        device        char * dst,
+        threadgroup   char * shmem [[threadgroup(0)]],
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort3 tpitg[[thread_position_in_threadgroup]]) {
+    threadgroup T1 * tile = (threadgroup T1 *) shmem; // [32][33]
+
+    const int64_t i0b = (int64_t) tgpig[0]*32;
+    const int64_t i1b = (int64_t) tgpig[1]*32;
+    const int64_t i2  = tgpig[2] % args.ne02;
+    const int64_t i3  = tgpig[2] / args.ne02;
+
+    const short tx = tpitg[0];
+
+    device const char * src = src0 + i2*args.nb02 + i3*args.nb03;
+    for (short r = tpitg[1]; r < 32; r += 8) {
+        const int64_t i0 = i0b + r;
+        const int64_t i1 = i1b + tx;
+        if (i0 < args.ne00 && i1 < args.ne01) {
+            tile[r*33 + tx] = (T1) *((device const T0 *) (src + i0*args.nb00 + i1*args.nb01));
+        }
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    device char * out = dst + i2*args.nb2 + i3*args.nb3;
+    for (short r = tpitg[1]; r < 32; r += 8) {
+        const int64_t i0 = i0b + tx;
+        const int64_t i1 = i1b + r;
+        if (i0 < args.ne00 && i1 < args.ne01) {
+            *((device T1 *) (out + i0*args.nb0 + i1*args.nb1)) = tile[tx*33 + r];
+        }
+    }
+}
+
+typedef decltype(kernel_cpy_tr<float, float>) kernel_cpy_tr_t;
+
+// A copy between tensors of the same shape whose rows are contiguous in both, as out of a view
+// that keeps dim 0 where it is: a row (or ntg[1] short ones) a group, its threads along it.
+// kernel_cpy_t_t works out from the flat index where each entry goes, a thread an entry. The same
+// values as kernel_cpy_t_t writes.
+template<typename T0, typename T1>
+kernel void kernel_cpy_rows(
+        constant ggml_metal_kargs_cpy & args,
+        device  const char * src0,
+        device        char * dst,
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort3 tpitg[[thread_position_in_threadgroup]],
+        ushort3   ntg[[threads_per_threadgroup]]) {
+    const int32_t i01 = tgpig[0]*ntg[1] + tpitg[1];
+    const int32_t i02 = tgpig[1];
+    const int32_t i03 = tgpig[2];
+
+    if (i01 >= args.ne01) {
+        return;
+    }
+
+    device const T0 * src = (device const T0 *) (src0 + i03*args.nb03 + i02*args.nb02 + i01*args.nb01);
+    device       T1 * out = (device       T1 *) (dst  + i03*args.nb3  + i02*args.nb2  + i01*args.nb1);
+
+    for (int32_t i00 = tpitg[0]; i00 < args.ne00; i00 += ntg[0]) {
+        out[i00] = (T1) src[i00];
+    }
+}
+
+typedef decltype(kernel_cpy_rows<float, float>) kernel_cpy_rows_t;
+
+template [[host_name("kernel_cpy_rows_f32_f32")]] kernel kernel_cpy_rows_t kernel_cpy_rows<float, float>;
+template [[host_name("kernel_cpy_rows_f32_f16")]] kernel kernel_cpy_rows_t kernel_cpy_rows<float, half>;
+template [[host_name("kernel_cpy_rows_f16_f16")]] kernel kernel_cpy_rows_t kernel_cpy_rows<half,  half>;
+template [[host_name("kernel_cpy_rows_f16_f32")]] kernel kernel_cpy_rows_t kernel_cpy_rows<half,  float>;
+
+template [[host_name("kernel_cpy_tr_f32_f32")]] kernel kernel_cpy_tr_t kernel_cpy_tr<float, float>;
+template [[host_name("kernel_cpy_tr_f32_f16")]] kernel kernel_cpy_tr_t kernel_cpy_tr<float, half>;
+template [[host_name("kernel_cpy_tr_f16_f16")]] kernel kernel_cpy_tr_t kernel_cpy_tr<half,  half>;
+template [[host_name("kernel_cpy_tr_f16_f32")]] kernel kernel_cpy_tr_t kernel_cpy_tr<half,  float>;
