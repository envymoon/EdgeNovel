+// 1D: a thread an entry of the output, the threads of a group along its rows (x: ic*KW + ikw,
+// y: output position), so every thread of a group works and the writes go out in rows.
+// kernel_im2col gives a group KW threads, a fifth of a SIMD group at KW = 7 and one thread at
+// KW = 1. The same values as kernel_im2col writes.
+template <typename T>
+kernel void kernel_im2col_1d(
+        constant ggml_metal_kargs_im2col & args,
+        device const float * x,
+        device        char * dst,
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort3 tpitg[[thread_position_in_threadgroup]],
+        ushort3   ntg[[threads_per_threadgroup]]) {
+    const int64_t i   = (int64_t) tgpig[0]*ntg[0] + tpitg[0];
+    const int64_t iow = (int64_t) tgpig[1]*ntg[1] + tpitg[1];
+
+    if (i >= args.CHW || iow >= args.OW) {
+        return;
+    }
+
+    const int64_t in  = tgpig[2];
+    const int64_t iic = i/args.KW;
+    const int64_t ikw = i - iic*args.KW;
+    const int64_t iiw = iow*args.s0 + ikw*args.d0 - args.p0;
+
+    device T * pdst = (device T *) dst + (in*args.OW + iow)*args.CHW + i;
+
+    if (iiw < 0 || iiw >= args.IW) {
+        *pdst = 0.0f;
+    } else {
+        *pdst = x[in*args.ofs0 + iic*args.ofs1 + iiw];
+    }
+}
+
+typedef decltype(kernel_im2col_1d<float>) im2col_1d_t;
