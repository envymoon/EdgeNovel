+// 1D by tiles: a group TW output positions and ICB input channels. The input those read, SP
+// positions of each channel, goes to threadgroup memory along its rows once, zero outside the
+// input; then the group's threads lie along the ICB*KW entries of an output row (x) and over its
+// positions (y), and write in rows. The same values as kernel_im2col writes.
+template <typename T>
+kernel void kernel_im2col_1d_tile(
+        constant ggml_metal_kargs_im2col & args,
+        device const float * x,
+        device        char * dst,
+        threadgroup  float * shmem [[threadgroup(0)]],
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort3 tpitg[[thread_position_in_threadgroup]],
+        ushort3   ntg[[threads_per_threadgroup]]) {
+    const int32_t IC  = args.CHW/args.KW;
+    const int32_t ow0 = tgpig[0]*args.TW;
+    const int32_t ic0 = tgpig[1]*args.ICB;
+    const int32_t in  = tgpig[2];
+    const int32_t nic = min(args.ICB, IC - ic0);
+    const int32_t iw0 = ow0*args.s0 - args.p0;
+
+    device const float * xs = x + in*args.ofs0 + ic0*args.ofs1;
+
+    const int32_t nt  = ntg[0]*ntg[1];
+    const int32_t tid = tpitg[1]*ntg[0] + tpitg[0];
+    for (int32_t e = tid; e < nic*args.SP; e += nt) {
+        const int32_t c  = e/args.SP;
+        const int32_t j  = e - c*args.SP;
+        const int32_t iw = iw0 + j;
+        shmem[e] = (iw >= 0 && iw < args.IW) ? xs[c*args.ofs1 + iw] : 0.0f;
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    const int32_t r = tpitg[0];
+    if (r >= nic*args.KW) {
+        return;
+    }
+
+    const int32_t c   = r/args.KW;
+    const int32_t k   = r - c*args.KW;
+    const int32_t now = min(args.TW, args.OW - ow0);
+
+    threadgroup const float * from = shmem + c*args.SP + k*args.d0;
+    device T * pdst = (device T *) dst + ((int64_t) in*args.OW + ow0)*args.CHW + ic0*args.KW + r;
+
+    for (int32_t o = tpitg[1]; o < now; o += ntg[1]) {
+        pdst[(int64_t) o*args.CHW] = from[o*args.s0];
+    }
+}
+
+typedef decltype(kernel_im2col_1d_tile<float>) im2col_1d_tile_t;
+
+template [[host_name("kernel_im2col_1d_tile_f32")]] kernel im2col_1d_tile_t kernel_im2col_1d_tile<float>;
+template [[host_name("kernel_im2col_1d_tile_f16")]] kernel im2col_1d_tile_t kernel_im2col_1d_tile<half>;
+
+template [[host_name("kernel_im2col_1d_f32")]] kernel im2col_1d_t kernel_im2col_1d<float>;
+template [[host_name("kernel_im2col_1d_f16")]] kernel im2col_1d_t kernel_im2col_1d<half>;
