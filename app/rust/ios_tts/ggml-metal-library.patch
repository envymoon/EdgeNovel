+void ggml_metal_fusion_skip_parse(const char * list) {
+    static const struct { const char * name; unsigned bits; } names[] = {
+        { "mul_mat_add",       1u << GGML_METAL_FUSION_MUL_MAT_ADD },
+        { "mul_mat_add_batch", GGML_METAL_FUSION_SKIP_ADD_BATCH },
+        { "mul_mat_add_part",  GGML_METAL_FUSION_SKIP_ADD_PART },
+        { "snake",             1u << GGML_METAL_FUSION_SNAKE },
+        { "add_chain",         1u << GGML_METAL_FUSION_ADD_CHAIN },
+        { "norm",              (1u << GGML_METAL_FUSION_NORM_MUL) | (1u << GGML_METAL_FUSION_NORM_MUL_ADD) |
+                               (1u << GGML_METAL_FUSION_NORM_SCALE) },
+    };
+    ggml_metal_fusion_skip = 0;
+    for (const char * p = list; p && *p; ) {
+        const char * e = strchr(p, ',');
+        const size_t n = e ? (size_t) (e - p) : strlen(p);
+        for (const auto & k : names) {
+            if (strlen(k.name) == n && strncmp(k.name, p, n) == 0) {
+                ggml_metal_fusion_skip |= k.bits;
+            }
+        }
+        p = e ? e + 1 : p + n;
+    }
+}
