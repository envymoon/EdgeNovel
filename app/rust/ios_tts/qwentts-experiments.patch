+// The codec thread: the same decode as tts_engine_codec_flush, one work
+// item at a time, on the codec's own backend.
+static void tts_codec_worker(TtsEngine * e) {
+    PipelineTTS *        pt   = e->pt;
+    const int            K    = pt->num_code_groups;
+    const int            hop  = TOKENIZER_HOP_LENGTH;
+    const int            maxT = 1 << (CODEC_STREAM_CLASSES - 1);
+    std::vector<int32_t> codes;
+    std::vector<float>   audio;
+    std::vector<float *> outs;
+    for (;;) {
+        TtsEngine::CodecWork w;
+        {
+            std::unique_lock<std::mutex> lk(e->codec_mu);
+            e->codec_cv.wait(lk, [&] { return e->codec_stop || !e->codec_queue.empty(); });
+            if (e->codec_queue.empty()) {
+                return;
+            }
+            w = std::move(e->codec_queue.front());
+            e->codec_queue.pop_front();
+        }
+        Timer     t_codec;
+        bool      ok   = true;
+        const int M    = w.M;
+        int       done = 0;
+        codes.resize((size_t) maxT * (size_t) M * (size_t) K);
+        audio.resize((size_t) M * (size_t) maxT * (size_t) hop);
+        outs.assign((size_t) M, nullptr);
+        while (ok && done < w.n) {
+            int T = maxT;
+            while (T > w.n - done) {
+                T >>= 1;
+            }
+            for (int m = 0; m < M; m++) {
+                for (int k = 0; k < K; k++) {
+                    for (int t = 0; t < T; t++) {
+                        codes[(size_t) (m * K + k) * (size_t) T + (size_t) t] =
+                            w.rows[((size_t) (done + t) * (size_t) M + (size_t) m) * (size_t) K + (size_t) k];
+                    }
+                }
+                outs[(size_t) m] = w.lanes[(size_t) m] ? audio.data() + (size_t) m * (size_t) maxT * (size_t) hop : nullptr;
+            }
+            ok = pipeline_codec_decode_stream_batch(&pt->codec, codes.data(), T, M, outs.data());
+            for (int m = 0; ok && m < M; m++) {
+                if (outs[(size_t) m]) {
+                    const struct qt_tts_params * p = w.lanes[(size_t) m]->job->params;
+                    if (!p->on_chunk(outs[(size_t) m], T * hop, p->on_chunk_user_data)) {
+                        qt_log(QT_LOG_INFO, "[Pipeline] on_chunk callback declined a chunk (lane %d)", m);
+                    }
+                }
+            }
+            done += T;
+        }
+        const double ms = t_codec.ms();
+        {
+            std::lock_guard<std::mutex> lk(e->codec_mu);
+            for (TtsSlot * s : w.lanes) {
+                if (s) {
+                    s->perf.codec_ms += ms;
+                }
+            }
+            if (!ok) {
+                e->codec_failed = true;
+            }
+            if (e->codec_queue.empty()) {
+                e->codec_busy = false;
+            }
+        }
+        e->codec_cv.notify_all();
+    }
+}
+
+// Until the codec thread is idle; false when an item it ran failed.
+static bool tts_codec_wait(TtsEngine * e) {
+    if (!e->pt->codec_async) {
+        return true;
+    }
+    std::unique_lock<std::mutex> lk(e->codec_mu);
+    e->codec_cv.wait(lk, [&] { return !e->codec_busy && e->codec_queue.empty(); });
+    const bool ok   = !e->codec_failed;
+    e->codec_failed = false;
+    return ok;
+}
