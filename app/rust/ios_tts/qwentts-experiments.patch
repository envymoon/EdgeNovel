+namespace {
+
+struct DiagRun {
+    std::vector<float>   logits;  // [frames][vocab], the c0 logits each frame sampled from
+    std::vector<int32_t> codes;   // [frames][K]
+    std::vector<float>   pcm;     // the streamed audio
+};
+
+bool diag_chunk(const float * s, int n, void * user) {
+    auto * r = static_cast<DiagRun *>(user);
+    r->pcm.insert(r->pcm.end(), s, s + n);
+    return true;
+}
+
+// k copies of one request, all admitted before the first step so they go
+// in lockstep. The batch's wall time in ms, negative when one failed.
+double diag_speak(qt_context * q, const qt_tts_params & base, int k, std::vector<DiagRun> & runs) {
+    runs.assign((size_t) k, DiagRun{});
+    std::vector<qt_tts_params> params((size_t) k, base);
+    std::vector<qt_audio>      outs((size_t) k, qt_audio{});
+    std::vector<TtsJob>        jobs((size_t) k);
+    for (int i = 0; i < k; i++) {
+        params[(size_t) i].on_chunk           = diag_chunk;
+        params[(size_t) i].on_chunk_user_data = &runs[(size_t) i];
+        TtsJob & j                            = jobs[(size_t) i];
+        j.params                              = &params[(size_t) i];
+        j.resolved_seed                       = base.seed;
+        j.out                                 = &outs[(size_t) i];
+        j.status                              = QT_STATUS_OK;
+        j.done                                = false;
+        j.probe_logits                        = &runs[(size_t) i].logits;
+        j.probe_codes                         = &runs[(size_t) i].codes;
+    }
+    TtsEngine * e  = tts_engine_new(&q->pt, &q->tok);
+    bool        ok = true;
+    Timer       t;
+    for (TtsJob & j : jobs) {
+        ok = tts_engine_admit(e, &j) && ok;
+    }
+    std::vector<TtsJob *> retired;
+    while (tts_engine_active(e) > 0) {
+        retired.clear();
+        tts_engine_step(e, &retired);
+    }
+    const double ms = t.ms();
+    tts_engine_free(e);
+    for (qt_audio & a : outs) {
+        qt_audio_free(&a);
+    }
+    for (const TtsJob & j : jobs) {
+        ok = ok && j.status == QT_STATUS_OK;
+    }
+    return ok ? ms : -1.0;
+}
+
+int diag_frames(const DiagRun & r, int K) {
+    return (int) (r.codes.size() / (size_t) K);
+}
+
+// The first frame whose codes differ and its first codebook that does;
+// (frames, -1) when they agree to the end of both.
+std::pair<int, int> diag_first_diff(const DiagRun & a, const DiagRun & b, int K) {
+    const int n = std::min(diag_frames(a, K), diag_frames(b, K));
+    for (int f = 0; f < n; f++) {
+        for (int g = 0; g < K; g++) {
+            if (a.codes[(size_t) f * (size_t) K + (size_t) g] != b.codes[(size_t) f * (size_t) K + (size_t) g]) {
+                return { f, g };
+            }
+        }
+    }
+    return { n, -1 };
+}
+
+// The widest gap between two runs' c0 logits over frames [0, upto], the
+// frames whose inputs were the same; and the largest logit, for scale.
+std::pair<double, double> diag_logit_gap(const DiagRun & a, const DiagRun & b, int vocab, int upto) {
+    const int n = std::min({ upto + 1, (int) (a.logits.size() / (size_t) vocab),
+                             (int) (b.logits.size() / (size_t) vocab) });
+    double    gap = 0.0, top = 0.0;
+    for (size_t i = 0; i < (size_t) std::max(n, 0) * (size_t) vocab; i++) {
+        gap = std::max(gap, (double) std::fabs(a.logits[i] - b.logits[i]));
+        top = std::max(top, (double) std::fabs(a.logits[i]));
+    }
+    return { gap, top };
+}
+
+double diag_snr(const std::vector<float> & ref, const std::vector<float> & x) {
+    const size_t n = std::min(ref.size(), x.size());
+    double       s = 0.0, e = 0.0;
+    for (size_t i = 0; i < n; i++) {
+        s += (double) ref[i] * ref[i];
+        e += ((double) ref[i] - x[i]) * ((double) ref[i] - x[i]);
+    }
+    return e == 0.0 ? 999.0 : 10.0 * std::log10(s / e);
+}
