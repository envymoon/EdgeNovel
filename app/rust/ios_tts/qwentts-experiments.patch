+// The periodic flush on the codec thread: the pending rows and, per lane,
+// the slot that hears them, decided now as tts_engine_codec_flush would.
+static void tts_engine_codec_flush_async(TtsEngine * e) {
+    const int            M = e->codec_M;
+    const int            K = e->pt->num_code_groups;
+    TtsEngine::CodecWork w;
+    w.n = e->codec_pending_n;
+    w.M = M;
+    w.rows.assign(e->codec_pending.begin(),
+                  e->codec_pending.begin() + (ptrdiff_t) ((size_t) w.n * (size_t) M * (size_t) K));
+    w.lanes.assign((size_t) M, nullptr);
+    for (int m = 0; m < M; m++) {
+        TtsSlot *  s    = tts_engine_codec_lane_slot(e, m);
+        const bool want = s && e->codec_live[(size_t) m] && s->fin_status != QT_STATUS_CANCELLED &&
+                          s->job->params->on_chunk != NULL;
+        w.lanes[(size_t) m] = want ? s : nullptr;
+    }
+    e->codec_pending_n = 0;
+    {
+        std::lock_guard<std::mutex> lk(e->codec_mu);
+        e->codec_queue.push_back(std::move(w));
+        e->codec_busy = true;
+    }
+    e->codec_cv.notify_all();
+}
