+// Every node of gf on its own, twice, the faster kept: what each costs,
+// beside the whole graph's time. A node alone pays a submission too, so
+// what an empty node (a view) takes is counted off.
+void diag_profile(ggml_backend_t be, struct ggml_cgraph * gf, const char * label, FILE * f) {
+    if (!be || !gf) {
+        fprintf(f, "[profile] %s: no graph\n", label);
+        return;
+    }
+    double full = 1e30;
+    for (int r = 0; r < 3; r++) {
+        Timer t;
+        ggml_backend_graph_compute(be, gf);
+        full = std::min(full, t.ms());
+    }
+    const int               n   = ggml_graph_n_nodes(gf);
+    struct ggml_init_params ip  = { ggml_graph_overhead_custom(1, false), nullptr, true };
+    struct ggml_context *   cx  = ggml_init(ip);
+    struct ggml_cgraph *    one = ggml_new_graph_custom(cx, 1, false);
+    std::vector<double>     ms((size_t) n, 1e30);
+    for (int pass = 0; pass < 2; pass++) {
+        for (int i = 0; i < n; i++) {
+            ggml_graph_clear(one);
+            ggml_graph_add_node(one, ggml_graph_node(gf, i));
+            Timer t;
+            ggml_backend_graph_compute(be, one);
+            ms[(size_t) i] = std::min(ms[(size_t) i], t.ms());
+        }
+    }
+    ggml_free(cx);
+    std::vector<double> empty;
+    for (int i = 0; i < n; i++) {
+        const enum ggml_op op = ggml_graph_node(gf, i)->op;
+        if (op == GGML_OP_NONE || op == GGML_OP_VIEW || op == GGML_OP_RESHAPE || op == GGML_OP_PERMUTE ||
+            op == GGML_OP_TRANSPOSE) {
+            empty.push_back(ms[(size_t) i]);
+        }
+    }
+    std::sort(empty.begin(), empty.end());
+    const double base = empty.empty() ? *std::min_element(ms.begin(), ms.end()) : empty[empty.size() / 2];
+    double       sum  = 0.0;
+    std::vector<std::pair<std::string, std::pair<int, double>>> by_op;
+    for (int i = 0; i < n; i++) {
+        const double      c  = std::max(0.0, ms[(size_t) i] - base);
+        const std::string op = ggml_op_desc(ggml_graph_node(gf, i));
+        sum += c;
+        auto it = std::find_if(by_op.begin(), by_op.end(), [&](const auto & p) { return p.first == op; });
+        if (it == by_op.end()) {
+            by_op.push_back({ op, { 1, c } });
+        } else {
+            it->second.first++;
+            it->second.second += c;
+        }
+    }
+    std::sort(by_op.begin(), by_op.end(),
+              [](const auto & a, const auto & b) { return a.second.second > b.second.second; });
+    fprintf(f, "[profile] %s: whole graph %.2f ms · %d nodes · alone %.2f ms after %.3f ms each for the submission\n",
+            label, full, n, sum, base);
+    for (size_t i = 0; i < by_op.size() && i < 14; i++) {
+        fprintf(f, "  %-18s %5d nodes %8.2f ms\n", by_op[i].first.c_str(), by_op[i].second.first,
+                by_op[i].second.second);
+    }
+    std::vector<int> order((size_t) n);
+    for (int i = 0; i < n; i++) {
+        order[(size_t) i] = i;
+    }
+    std::sort(order.begin(), order.end(), [&](int a, int b) { return ms[(size_t) a] > ms[(size_t) b]; });
+    for (int k = 0; k < n && k < 16; k++) {
+        const struct ggml_tensor * t = ggml_graph_node(gf, order[(size_t) k]);
+        fprintf(f, "  #%-5d %-26.26s %-14s %7.3f ms  %s <- %s %s\n", order[(size_t) k], t->name, ggml_op_desc(t),
+                ms[(size_t) order[(size_t) k]] - base, diag_shape(t).c_str(), diag_shape(t->src[0]).c_str(),
+                diag_shape(t->src[1]).c_str());
+    }
+}
+
+struct ggml_cgraph * diag_talker_graph(PipelineTTS * pt, int N) {
+    for (TalkerDecodeGraph & g : pt->talker_decode_graphs) {
+        if (g.gf && g.N == N) {
+            return g.gf;
+        }
+    }
+    return nullptr;
+}
+
+struct ggml_cgraph * diag_predictor_graph(PipelineTTS * pt, int N) {
+    return (size_t) N <= pt->cp_graphs.size() ? pt->cp_graphs[(size_t) N - 1].frame.gf : nullptr;
+}
+
+struct ggml_cgraph * diag_codec_graph(PipelineCodec * pc, int cls, int M) {
+    const size_t i = (size_t) cls * (size_t) (pc->stream_sets - 1) + (size_t) (M - 1);
+    return i < pc->stream_graphs.size() ? pc->stream_graphs[i].gf : nullptr;
+}
+
+void diag_profile_all(qt_context * q, int N, FILE * f) {
+    char label[64];
+    snprintf(label, sizeof(label), "talker N=%d", N);
+    diag_profile(q->pt.backend, diag_talker_graph(&q->pt, N), label, f);
+    snprintf(label, sizeof(label), "predictor N=%d", N);
+    diag_profile(q->pt.backend, diag_predictor_graph(&q->pt, N), label, f);
+    snprintf(label, sizeof(label), "codec T=8 M=%d", N);
+    diag_profile(q->pt.codec.backend, diag_codec_graph(&q->pt.codec, 3, N), label, f);
+}
+
+// The lone run's codes through 1, 2 and 4 codec lanes at once, 8 frames
+// a chunk: every lane's audio against the one lane's.
+void diag_codec(qt_context * q, const DiagRun & ref, FILE * f) {
+    PipelineCodec * pc  = &q->pt.codec;
+    const int       K   = q->pt.num_code_groups;
+    const int       hop = TOKENIZER_HOP_LENGTH;
+    const int       T   = 8;
+    const int       F   = diag_frames(ref, K) / T * T;
+    if (F == 0) {
+        fprintf(f, "[codec] too few frames\n");
+        return;
+    }
+    std::vector<float> one;
+    for (int M : { 1, 2, 4 }) {
+        if (M > pc->stream_sets - 1) {
+            break;
+        }
+        bool ok = true;
+        for (int m = 0; m < M && ok; m++) {
+            ok = pipeline_codec_stream_reset(pc, m);
+        }
+        std::vector<std::vector<float>> lanes((size_t) M);
+        std::vector<int32_t>            codes((size_t) T * (size_t) K * (size_t) M);
+        std::vector<float>              audio((size_t) M * (size_t) T * (size_t) hop);
+        std::vector<float *>            outs((size_t) M);
+        Timer                           t;
+        for (int c = 0; ok && c < F; c += T) {
+            for (int m = 0; m < M; m++) {
+                for (int k = 0; k < K; k++) {
+                    for (int i = 0; i < T; i++) {
+                        codes[((size_t) m * (size_t) K + (size_t) k) * (size_t) T + (size_t) i] =
+                            ref.codes[(size_t) (c + i) * (size_t) K + (size_t) k];
+                    }
+                }
+                outs[(size_t) m] = audio.data() + (size_t) m * (size_t) T * (size_t) hop;
+            }
+            ok = pipeline_codec_decode_stream_batch(pc, codes.data(), T, M, outs.data());
+            for (int m = 0; ok && m < M; m++) {
+                lanes[(size_t) m].insert(lanes[(size_t) m].end(), outs[(size_t) m],
+                                         outs[(size_t) m] + (size_t) T * (size_t) hop);
+            }
+        }
+        const double ms = t.ms();
+        if (!ok) {
+            fprintf(f, "[codec] M=%d failed\n", M);
+            continue;
+        }
+        if (M == 1) {
+            one = lanes[0];
+        }
+        fprintf(f, "[codec] M=%d · %d frames a lane · %.1f ms · %.2f ms a frame · SNR against one lane:", M, F, ms,
+                ms / (double) F / (double) M);
+        double worst = 999.0;
+        for (int m = 0; m < M; m++) {
+            const double s = diag_snr(one, lanes[(size_t) m]);
+            worst          = std::min(worst, s);
+            fprintf(f, " %.1f", s);
+        }
+        fprintf(f, " dB · streamed in the run %.1f dB\n", diag_snr(one, ref.pcm));
+        fprintf(f, "RESULT codec M=%d snr=%.1f ms_per_frame=%.2f\n", M, worst, ms / (double) F / (double) M);
+    }
+}
+
+}  // namespace
+
+int qt_diag(struct qt_context * q, const char * text, const char * speaker, int frames, int greedy, int profile,
+            const char * report_path) {
+    if (!q || !text || !report_path) {
+        return -1;
+    }
+    FILE * f = fopen(report_path, "w");
+    if (!f) {
+        return -1;
+    }
+    try {
+        // Holds back qt_synthesize: the worker is idle, and the engines
+        // here are the only ones that step.
+        std::lock_guard<std::mutex> lk(q->mu);
+        qt_tts_params               p;
+        qt_tts_default_params(&p);
+        p.text           = text;
+        p.lang           = "chinese";
+        p.speaker        = speaker;
+        p.max_new_tokens = frames;
+        p.seed           = 20261016;
+        if (greedy) {
+            p.temperature           = 0.0f;
+            p.subtalker_temperature = 0.0f;
+        }
+        const char * mode  = greedy ? "greedy" : "sampled";
+        const int    K     = q->pt.num_code_groups;
+        const int    vocab = q->pt.talker.vocab_size;
+        fprintf(f, "[diag] %s · up to %d frames · max_batch %d · flash attention %s\n", mode, frames,
+                q->pt.max_batch, q->pt.use_flash_attn ? "on" : "off");
+
+        std::vector<DiagRun> ref;
+        const double         ms1 = diag_speak(q, p, 1, ref);
+        const int            F1  = diag_frames(ref[0], K);
+        fprintf(f, "[N=1] %d frames · %.0f ms · %.1f ms a frame%s\n", F1, ms1, ms1 / std::max(F1, 1),
+                ms1 < 0 ? " · FAILED" : "");
+        fprintf(f, "RESULT %s N=1 frames=%d ms_per_frame=%.1f\n", mode, F1, ms1 / std::max(F1, 1));
+        fflush(f);
+        if (profile) {
+            diag_profile_all(q, 1, f);
+            fflush(f);
+        }
+        for (int k : { 2, 4 }) {
+            if (k > q->pt.max_batch) {
+                break;
+            }
+            std::vector<DiagRun> runs;
+            const double         ms   = diag_speak(q, p, k, runs);
+            int                  most = 0;
+            for (const DiagRun & r : runs) {
+                most = std::max(most, diag_frames(r, K));
+            }
+            fprintf(f, "[N=%d] %.0f ms · %.1f ms a frame of one lane%s\n", k, ms, ms / std::max(most, 1) / k,
+                    ms < 0 ? " · FAILED" : "");
+            int    same_lanes = 1, agree = most, gap_frame = 0;
+            double gap = 0.0, top = 0.0;
+            for (int i = 0; i < k; i++) {
+                const DiagRun & r    = runs[(size_t) i];
+                const auto      lane = diag_first_diff(r, runs[0], K);
+                const auto      lone = diag_first_diff(r, ref[0], K);
+                const auto      lg   = diag_logit_gap(r, ref[0], vocab, lone.first);
+                fprintf(f,
+                        "  lane %d: %d frames · same as lane 0 through frame %d%s · same as alone through frame %d "
+                        "(codebook %d) of %d · c0 logits within %.4f of alone up to there (largest %.1f)\n",
+                        i, diag_frames(r, K), lane.first, lane.second < 0 ? " (all)" : "", lone.first, lone.second,
+                        F1, lg.first, lg.second);
+                same_lanes = same_lanes && lane.second < 0 && diag_frames(r, K) == diag_frames(runs[0], K);
+                agree      = std::min(agree, lone.first);
+                if (lg.first > gap) {
+                    gap       = lg.first;
+                    gap_frame = lone.first;
+                }
+                top = std::max(top, lg.second);
+            }
+            fprintf(f, "RESULT %s N=%d lanes_same=%d agree=%d of=%d logit_gap=%.4f at=%d top=%.1f ms_per_frame=%.1f\n",
+                    mode, k, same_lanes, agree, F1, gap, gap_frame, top, ms / std::max(most, 1) / k);
+            fflush(f);
+            if (profile && k == std::min(4, q->pt.max_batch)) {
+                diag_profile_all(q, k, f);
+                fflush(f);
+            }
+        }
+        diag_codec(q, ref[0], f);
+    } catch (const std::exception & e) {
+        fprintf(f, "[diag] %s\n", e.what());
+    }
+    fclose(f);
+    return 0;
+}
