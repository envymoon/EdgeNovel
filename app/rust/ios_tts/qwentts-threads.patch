 struct BackendPair {
     ggml_backend_t backend;
@@ -28,6 +31,17 @@
 // Used for GGML CPU thread count: GEMM shares SIMD units across hyperthreads,
 // so one thread per physical core is optimal.
 static int backend_cpu_n_threads(void) {
+#if defined(__APPLE__)
+    // Apple silicon has no SMT: one thread per performance core, as
+    // llama.cpp counts them.
+    for (const char * key : { "hw.perflevel0.physicalcpu", "hw.physicalcpu" }) {
+        int    cores = 0;
+        size_t len   = sizeof(cores);
+        if (sysctlbyname(key, &cores, &len, nullptr, 0) == 0 && cores > 0) {
+            return cores;
+        }
+    }
+#endif
     int n = (int) std::thread::hardware_concurrency() / 2;
     return n > 0 ? n : 1;
 }
