+// Several servers may share one process (an app that cannot start processes
+// runs each on a thread). Each one, once its model is loaded, registers how to
+// stop it under its port, and unregisters before it is torn down.
+static std::mutex stop_by_port_mutex;
+static std::map<int, std::function<void()>> stop_by_port;
+
+bool llama_server_stop_port(int port);
+bool llama_server_stop_port(int port) {
+    std::lock_guard<std::mutex> lock(stop_by_port_mutex);
+    auto it = stop_by_port.find(port);
+    if (it == stop_by_port.end()) {
+        return false;
+    }
+    it->second();
+    return true;
+}
