--- a/ggml/src/ggml-metal/CMakeLists.txt
+++ b/ggml/src/ggml-metal/CMakeLists.txt
@@ -55,7 +55,35 @@
         VERBATIM
     )
 
-    target_sources(ggml-metal PRIVATE "${METALLIB_EMBED_ASM}")
+    if (GGML_METAL_EMBED_METALLIB_SDK)
+        # Embed the library compiled here rather than its source: compiled on
+        # the device, the first load takes seconds.
+        add_compile_definitions(GGML_METAL_EMBED_METALLIB)
+
+        set(METALLIB_AIR          "${CMAKE_CURRENT_BINARY_DIR}/autogenerated/ggml-metal.air")
+        set(METALLIB_COMPILED     "${CMAKE_CURRENT_BINARY_DIR}/autogenerated/ggml-metal.metallib")
+        set(METALLIB_COMPILED_ASM "${CMAKE_CURRENT_BINARY_DIR}/autogenerated/ggml-metal-compiled.s")
+
+        add_custom_command(
+            OUTPUT "${METALLIB_COMPILED_ASM}"
+            COMMAND xcrun -sdk ${GGML_METAL_EMBED_METALLIB_SDK} metal -O3 ${GGML_METAL_EMBED_METALLIB_FLAGS} -DGGML_METAL_EMBED_LIBRARY=1 -c "${METALLIB_SOURCE_EMBED}" -o "${METALLIB_AIR}"
+            COMMAND xcrun -sdk ${GGML_METAL_EMBED_METALLIB_SDK} metallib "${METALLIB_AIR}" -o "${METALLIB_COMPILED}"
+            COMMAND echo ".section __DATA,__ggml_metallib"          >  "${METALLIB_COMPILED_ASM}"
+            COMMAND echo ".p2align 4"                               >> "${METALLIB_COMPILED_ASM}"
+            COMMAND echo ".globl _ggml_metallib_start"              >> "${METALLIB_COMPILED_ASM}"
+            COMMAND echo "_ggml_metallib_start:"                    >> "${METALLIB_COMPILED_ASM}"
+            COMMAND echo .incbin "\"${METALLIB_COMPILED}\""         >> "${METALLIB_COMPILED_ASM}"
+            COMMAND echo ".globl _ggml_metallib_end"                >> "${METALLIB_COMPILED_ASM}"
+            COMMAND echo "_ggml_metallib_end:"                      >> "${METALLIB_COMPILED_ASM}"
+            DEPENDS "${METALLIB_EMBED_ASM}"
+            COMMENT "Compile the embedded Metal library"
+            VERBATIM
+        )
+
+        target_sources(ggml-metal PRIVATE "${METALLIB_COMPILED_ASM}")
+    else()
+        target_sources(ggml-metal PRIVATE "${METALLIB_EMBED_ASM}")
+    endif()
 else()
     # copy metal files to bin directory
     configure_file(../ggml-common.h  ${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/ggml-common.h     COPYONLY)
--- a/ggml/src/ggml-metal/ggml-metal-device.m
+++ b/ggml/src/ggml-metal/ggml-metal-device.m
@@ -122,12 +122,28 @@
         NSString * src = nil;
 
 #if GGML_METAL_EMBED_LIBRARY
-        GGML_LOG_INFO("%s: using embedded metal library\n", __func__);
-
         extern const char ggml_metallib_start[];
         extern const char ggml_metallib_end[];
 
+#if defined(GGML_METAL_EMBED_METALLIB)
+        GGML_LOG_INFO("%s: using embedded compiled metal library\n", __func__);
+
+        // static bytes: nothing to free
+        dispatch_data_t data = dispatch_data_create(ggml_metallib_start, ggml_metallib_end - ggml_metallib_start,
+                dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^{});
+        library = [device newLibraryWithData:data error:&error];
+#if !__has_feature(objc_arc)
+        dispatch_release(data);
+#endif
+        if (error) {
+            GGML_LOG_ERROR("%s: error: %s\n", __func__, [[error description] UTF8String]);
+            return nil;
+        }
+#else
+        GGML_LOG_INFO("%s: using embedded metal library\n", __func__);
+
         src = [[NSString alloc] initWithBytes:ggml_metallib_start length:(ggml_metallib_end-ggml_metallib_start) encoding:NSUTF8StringEncoding];
+#endif
 #else
 
 #ifdef SWIFT_PACKAGE
@@ -710,6 +726,13 @@
                 dev->props.has_tensor = false;
             }
 
